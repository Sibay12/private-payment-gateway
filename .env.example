# Required
MONGO_URI=
API_SECRET_KEY=            # must equal PRIVATE_API_KEY on the main site
GMAIL_USER=
GMAIL_APP_PASSWORD=        # 16-digit Gmail app password

# Optional
BUSINESS_UPI=paytm.s2ujlw0@pty
PAYEE_NAME=TaknaPay
PUBLIC_URL=https://taknapay.in   # public address of the gateway (checkout links, self-ping)
# REDIRECT_OLD_URL=false      # set to false to stop redirecting *.onrender.com pages to PUBLIC_URL
SITE_WEBHOOK_URL=          # e.g. https://your-site.com/api/payment-webhook
AUTO_CHECK_HOURS=1         # mailbox is checked this long; then the order is cancelled and goes to the admin's approval list
ADMIN_SECRET_PASS=         # admin panel password (same value as the main site)

# Anti-sleep (dynamic): the public URL is auto-detected (RENDER_EXTERNAL_URL, or learned from the
# first real request). Nothing to set. KEEP_ALIVE_URL is only an optional manual override;
# KEEP_ALIVE=false turns pinging off.
KEEP_ALIVE_URL=
KEEP_ALIVE=true
PING_INTERVAL_MIN=5      # self-ping interval in minutes (1-14, default 5)

# ---- Mail checking (payment mails from ANY sender are matched by orderId + exact amount) ----
# MAIL_FOLDERS=INBOX,[Gmail]/Spam   # folders to scan; Gmail folder names depend on the account language
# MAIL_SCAN_LIMIT=200               # newest N mails per folder (last ~2 days)

# ---- Admin access from another site / backend ----
# Long random string (24+ chars). Send it as header  x-admin-key: <value>  to any /api/admin/* route.
# Keep it on the other site's SERVER side - never in browser JavaScript.
ADMIN_REMOTE_KEY=
# ADMIN_ALLOWED_ORIGINS=*           # or https://site1.com,https://site2.com (only matters for browser calls)

# Cancelled orders stay in the admin's "Needs approval" list this many hours after creation
# EXPIRE_HOURS=24

# Check speed: every 15 s for the first FAST_CHECK_SECONDS of an order, then once every SLOW_CHECK_MINUTES
# FAST_CHECK_SECONDS=120
# SLOW_CHECK_MINUTES=15
